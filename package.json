{
  "name": "parikshaa",
  "private": true,
  "version": "0.0.0",
  "description": "Parikshaa (\u092a\u0930\u0940\u0915\u094d\u0937\u093e) \u2014 assessment platform with a tamper-evident exam ledger and an AI micro-viva engine.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/api",
    "typecheck": "tsc -b packages/api --force && tsc -p tsconfig.tests.json",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm test",
    "start": "node packages/api/dist/main.js"
  },
  "engines": {
    "node": ">=20"
  }
}
