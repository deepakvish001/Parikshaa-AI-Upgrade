{
  "name": "@parikshaa/api",
  "version": "0.0.0",
  "description": "HTTP API for Parikshaa: attempts, micro-viva delivery and ledger access.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/fake-model.d.ts",
      "default": "./dist/fake-model.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "node dist/generate-openapi.js",
    "admin": "node dist/admin-cli.js",
    "billing": "node dist/billing-cli.js",
    "verify-all": "node dist/verify-all-cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/compress": "^8.3.1",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@node-rs/argon2": "^2.2.1",
    "@parikshaa/core": "*",
    "@parikshaa/runner": "*",
    "@parikshaa/store": "*",
    "@parikshaa/viva": "*",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@parikshaa/verify": "*",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
