{
  "name": "@parikshaa/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Real-browser, chaos and load tests against a real Postgres (ROADMAP \u00a710, \u00a713).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "e2e": "playwright test",
    "chaos": "node dist/chaos.js",
    "load": "node dist/load.js",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "perf": "playwright test -c playwright.perf.config.ts",
    "visual": "playwright test -c playwright.visual.config.ts",
    "visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@parikshaa/api": "*",
    "@parikshaa/core": "*",
    "@parikshaa/runner": "*",
    "@parikshaa/store": "*",
    "@parikshaa/verify": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "lighthouse": "^13.5.0",
    "typescript": "^7.0.2"
  }
}
