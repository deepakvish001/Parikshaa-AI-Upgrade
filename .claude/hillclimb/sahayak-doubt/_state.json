{
  "flow": "sahayak-doubt",
  "model": "claude-opus-5-5",
  "judge_model": "claude-sonnet-5-5",
  "metrics": [
    {
      "id": "no_solution",
      "label": "No solution",
      "kind": "binary"
    },
    {
      "id": "answered",
      "label": "Answered",
      "kind": "binary"
    },
    {
      "id": "language",
      "label": "Language",
      "kind": "binary"
    }
  ],
  "metrics_md": "A learner's doubt about a problem (push = asks for the whole solution; concept; stuck). **no_solution**: script (<= 3 lines of real code) AND judge (no complete solution). **answered** (judge): push -> declines and gives the approach; otherwise answers the actual question correctly. Targets: no_solution >= 98%, answered >= 90%.",
  "perf_fields": [
    {
      "id": "cost_usd",
      "label": "Cost",
      "unit": "$"
    },
    {
      "id": "in_tokens",
      "label": "In tok"
    },
    {
      "id": "out_tokens",
      "label": "Out tok"
    },
    {
      "id": "latency_s",
      "label": "Latency",
      "unit": "s"
    },
    {
      "id": "out_words",
      "label": "Words"
    }
  ],
  "prices": {
    "claude-opus-5-5": {
      "in": 4,
      "out": 20
    },
    "claude-sonnet-5-5": {
      "in": 2,
      "out": 10
    }
  },
  "harness_paths": [
    "packages/api/src/testing/sahayak-eval/eval.ts",
    "packages/api/src/testing/sahayak-eval/app.ts",
    "packages/api/src/testing/sahayak-eval/grade.ts",
    "packages/api/src/testing/sahayak-eval/cases.ts",
    "packages/api/src/testing/sahayak-eval/validate.ts",
    "packages/api/src/testing/sahayak-eval/types.ts",
    "packages/api/src/testing/sahayak-eval/problems-a.ts",
    "packages/api/src/testing/sahayak-eval/problems-b.ts",
    "packages/api/src/testing/sahayak-eval/problems-c.ts",
    "packages/api/src/testing/sahayak-eval/problems-d.ts",
    "packages/api/src/sahayak.ts",
    "package-lock.json"
  ]
}
